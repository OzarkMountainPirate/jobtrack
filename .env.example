# ---------------------------------------------------------------- Matrix ----
# The bot is driven from one Matrix room. Create a user for it on your
# homeserver, create a private UNENCRYPTED room, invite the bot, and put the
# room's internal ID here - the name will not work.
MATRIX_HOMESERVER=https://matrix.example.net
MATRIX_USER_ID=@jobtrack:example.net
MATRIX_TOKEN=syt_xxxxxxxxxxxxxxxxxxxx
MATRIX_ROOM=!abcdefghijklmnop:example.net
MATRIX_DEVICE_ID=JOBTRACKBOT

# ------------------------------------------------------------- behaviour ----
BOT_PREFIX=!
STALE_DAYS=7                # days of silence before an application is "quiet"
CHECK_AT=06:30              # daily digest time, container local time
CHECK_DAYS=0,1,2,3,4        # Mon=0. Weekdays only, so weekends stay quiet.
LOG_LEVEL=INFO
ALERT_SCORE=8               # announce new leads scoring at least this

# ------------------------------------------------------ scoring (local) ----
# Ollama, anywhere you can reach it. A 3-4B instruct model is enough: scoring
# is a classification task, and this runs once per lead.
OLLAMA_URL=http://localhost:11434
SCORING_MODEL=phi4-mini:latest
# GAPS_MODEL=                 # defaults to SCORING_MODEL

# Pay bands. Both are also readable from profile.json, which wins if set.
# TARGET_SALARY=90000         # what you are aiming for - only ever lifts a lead
# CURRENT_ANNUAL=46800        # what you earn now - the only thing that lowers one

# ---------------------------------------------------- drafting (paid API) --
# Only used by !draft. Leave unset and everything else still works.
# ANTHROPIC_API_KEY=sk-ant-...
# DRAFT_MODEL=claude-opus-5

# ------------------------------------------- page watching (optional) ------
# changedetection.io, for career pages with no feed or API.
CD_URL=http://changedetection:5000
# CD_API_KEY=                 # Settings -> API in the changedetection UI

# ------------------------------------------------ mail tracking (optional) -
# Microsoft Graph, delegated device-code flow. Register an app in Entra with
# the delegated Mail.Read scope and public client flows enabled, then !mailauth.
# GRAPH_CLIENT_ID=
# GRAPH_TENANT_ID=common

# Some HireTrue boards need their numeric board key for enrichment.
# HIRETRUE_BOARD_KEY=417
